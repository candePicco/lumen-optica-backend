# Copiar a .env (ignorado por Git): cp .env.example .env
# Docker Compose lee .env para interpolar las variables de compose.yaml.

# --- Base de datos (las lee la imagen postgres y tambien Django) ---
# Nombre de la base de datos.
POSTGRES_DB=lumen_optica
# Usuario de la base de datos.
POSTGRES_USER=lumen
# Contrasena de la base. VALOR DE EJEMPLO SOLO PARA PRACTICA: cambiarlo.
POSTGRES_PASSWORD=cambiar-solo-practica

# --- Django ---
# 1 = modo desarrollo; 0 = produccion (exige DJANGO_SECRET_KEY).
DJANGO_DEBUG=1
# Clave secreta; obligatoria con DJANGO_DEBUG=0 (generar con: openssl rand -hex 32).
DJANGO_SECRET_KEY=
# Hosts permitidos separados por coma; dejar 127.0.0.1 (lo usa el healthcheck).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origenes del frontend que pueden llamar a la API (CORS), separados por coma.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origenes https confiables para formularios con CSRF (ej. login del admin en un dominio publico).
DJANGO_CSRF_TRUSTED_ORIGINS=
# Cookies solo por HTTPS; por defecto activo cuando DJANGO_DEBUG=0.
# DJANGO_SECURE_COOKIES=0
